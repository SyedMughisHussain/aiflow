# Copy this file to .env and fill in real values. Never commit .env.

# Database (PostgreSQL / Prisma)
DATABASE_URL=
# Direct (non-pooled) connection, used by Prisma Migrate
DIRECT_URL=

# Auth.js
AUTH_SECRET=

# AI (Groq, OpenAI-compatible API)
GROQ_API_KEY=
# Optional, defaults to "openai/gpt-oss-120b"
GROQ_MODEL=

# Stripe (use test mode keys during development)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# App
# Base URL used to build Stripe Checkout success/cancel redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
